{
  "name": "competitor-intel-system",
  "version": "1.0.0",
  "description": "Automated competitor intelligence system for scraping, analysis and reporting",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "start": "node dist/index.js",
    "dev": "node --import tsx/esm src/index.ts",
    "dev:all": "concurrently \"npm run dev:api\" \"npm run dev --prefix dashboard\"",
    "dev:run": "node --import tsx/esm src/index.ts run",
    "dev:scrape": "node --import tsx/esm src/index.ts scrape",
    "dev:analyze": "node --import tsx/esm src/index.ts analyze",
    "dev:generate": "node --import tsx/esm src/index.ts generate",
    "dev:deliver": "node --import tsx/esm src/index.ts deliver",
    "dev:migrate": "node --import tsx/esm src/index.ts migrate",
    "scheduler": "node --import tsx/esm src/scheduler.ts",
    "scheduler:pm2": "pm2 start ecosystem.config.js",
    "migrate": "node dist/index.js migrate",
    "migrate:direct": "node --import tsx/esm src/db/migrations/run.ts",
    "db:generate": "npx drizzle-kit generate",
    "db:push": "npx drizzle-kit push",
    "db:init": "node --import tsx/esm scripts/initDb.ts",
    "db:studio": "npx drizzle-kit studio",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "test:scraper": "node --import tsx/esm scripts/testApifyScraper.js",
    "dev:api": "node --import tsx/esm src/api/server.ts",
    "db:migrate": "node --import tsx/esm src/db/migrate.ts",
    "generate": "node --import tsx/esm scripts/generateReport.ts",
    "test:pipeline": "node --import tsx/esm scripts/testFullPipeline.ts",
    "test:mock": "node --import tsx/esm scripts/testFullPipeline.ts --mock",
    "test:live": "node --import tsx/esm scripts/testFullPipeline.ts --live"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "chart.js": "^4.5.1",
    "commander": "^12.1.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.1",
    "express": "^5.2.1",
    "google-trends-api": "^4.9.2",
    "handlebars": "^4.7.8",
    "node-cron": "^3.0.3",
    "nunjucks": "^3.2.4",
    "openai": "^4.104.0",
    "pg": "^8.13.1",
    "playwright": "^1.58.2",
    "puppeteer": "^24.1.1",
    "resend": "^4.1.2",
    "skia-canvas": "^1.0.2",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/handlebars": "^4.1.0",
    "@types/node": "^22.19.15",
    "@types/node-cron": "^3.0.11",
    "@types/nunjucks": "^3.2.6",
    "@types/pg": "^8.11.11",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.30.4",
    "eslint": "^9.20.1",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
