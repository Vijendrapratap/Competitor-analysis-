<div class="page-break" style="display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:90vh;text-align:center;">
  <div style="margin-bottom:3rem;">
    <div style="margin:0 auto 1.5rem;">
      <div style="display:inline-flex;align-items:center;gap:.6rem;background:var(--navy);padding:.6rem 1.4rem;border-radius:6px;">
        <span style="color:var(--gold);font-size:1.5rem;font-weight:900;letter-spacing:.05em;">UPMY</span>
        <span style="color:white;font-size:1.5rem;font-weight:700;letter-spacing:.05em;">SKILLS</span>
      </div>
      <div style="font-size:.75rem;color:var(--gray-500);letter-spacing:.15em;text-transform:uppercase;margin-top:.4rem;">Competitor Intelligence System</div>
    </div>
    <h1 style="font-size:2.4rem;color:var(--navy);margin-bottom:.5rem;border:none;">COMPETITOR<br/>INTELLIGENCE REPORT</h1>
    <h1 style="font-size:2.4rem;color:var(--navy);margin-bottom:.5rem;border:none;">
      <span class="thai" style="font-size:1.4rem;color:var(--gray-600);">รายงานข่าวกรองคู่แข่ง</span>
    </h1>
    <div style="width:60px;height:3px;background:var(--gold);margin:1.5rem auto;"></div>
    <p style="font-size:1.3rem;color:var(--gray-600);">{{reportDate}}</p>
    <p class="thai" style="font-size:1rem;color:var(--gray-500);">Hua Hin Hospitality Market</p>
    <p class="thai" style="font-size:1rem;color:var(--gray-500);">ตลาดโรงแรมหัวหิน</p>
  </div>

  <div style="margin-top:2rem;">
    <p style="font-size:.9rem;color:var(--gray-500);">
      Reporting Period: {{formatDate periodStart}} &mdash; {{formatDate periodEnd}}
    </p>
    <p class="thai" style="font-size:.85rem;color:var(--gray-500);">
      ช่วงเวลารายงาน: {{formatDate periodStart}} &mdash; {{formatDate periodEnd}}
    </p>
  </div>

  <div style="margin-top:4rem;padding:.6rem 2rem;border:2px solid var(--red);border-radius:4px;display:inline-block;">
    <span style="color:var(--red);font-weight:700;font-size:.85rem;letter-spacing:.1em;text-transform:uppercase;">
      CONFIDENTIAL / เอกสารลับ
    </span>
  </div>

  <div style="margin-top:2rem;">
    <small>Generated {{formatDateTime generatedAt}} &bull; {{marketOverview.totalCompetitors}} competitors tracked</small>
  </div>
</div>
