<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{reportTitle}} — {{reportDate}}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;600;700&display=swap" rel="stylesheet" />
  <style>
    /* ── Reset & Base ─────────────────────────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --navy:       #1a365d;
      --navy-light: #2a4a7f;
      --navy-dark:  #0f2440;
      --gold:       #d69e2e;
      --gold-light: #ecc94b;
      --gold-dark:  #b7791f;
      --green:      #38a169;
      --green-bg:   #f0fff4;
      --yellow:     #d69e2e;
      --yellow-bg:  #fffff0;
      --red:        #e53e3e;
      --red-bg:     #fff5f5;
      --gray-50:    #f7fafc;
      --gray-100:   #edf2f7;
      --gray-200:   #e2e8f0;
      --gray-300:   #cbd5e0;
      --gray-500:   #718096;
      --gray-600:   #4a5568;
      --gray-700:   #2d3748;
      --gray-800:   #1a202c;
      --white:      #ffffff;
      --font:       'Sarabun', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    }

    html { font-size: 11pt; }

    body {
      font-family: var(--font);
      color: var(--gray-800);
      background: var(--white);
      line-height: 1.55;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    /* ── Print / A4 ───────────────────────────────────────────────────── */
    @page {
      size: A4;
      margin: 20mm 15mm;
    }

    .page-break       { page-break-after: always; }
    .page-break-before { page-break-before: always; }
    .no-break          { page-break-inside: avoid; }

    /* ── Typography ───────────────────────────────────────────────────── */
    h1 { font-size: 1.8rem; font-weight: 700; color: var(--navy); margin-bottom: .6rem; }
    h2 { font-size: 1.35rem; font-weight: 700; color: var(--navy); margin-bottom: .5rem; border-bottom: 2px solid var(--gold); padding-bottom: .3rem; }
    h3 { font-size: 1.1rem; font-weight: 600; color: var(--navy-light); margin-bottom: .4rem; }
    h4 { font-size: .95rem; font-weight: 600; color: var(--gray-700); margin-bottom: .3rem; }
    p  { margin-bottom: .6rem; }
    small { font-size: .8rem; color: var(--gray-500); }

    .thai { font-family: 'Sarabun', sans-serif; color: var(--gray-600); font-size: .9em; }

    /* ── Layout ────────────────────────────────────────────────────────── */
    .container { max-width: 190mm; margin: 0 auto; }
    .section   { margin-bottom: 1.5rem; }
    .flex      { display: flex; gap: 1rem; }
    .flex-wrap { flex-wrap: wrap; }
    .flex-1    { flex: 1; }
    .grid-2    { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .grid-3    { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem; }
    .text-center { text-align: center; }
    .text-right  { text-align: right; }
    .mt-1 { margin-top: .5rem; }
    .mt-2 { margin-top: 1rem; }
    .mb-1 { margin-bottom: .5rem; }
    .mb-2 { margin-bottom: 1rem; }

    /* ── Cards ─────────────────────────────────────────────────────────── */
    .card {
      background: var(--white);
      border: 1px solid var(--gray-200);
      border-radius: 6px;
      padding: 1rem;
      margin-bottom: .8rem;
    }
    .card-navy {
      background: var(--navy);
      color: var(--white);
      border: none;
    }
    .card-navy h3, .card-navy h4 { color: var(--gold); }
    .card-gold {
      border-left: 4px solid var(--gold);
    }

    /* ── Tables ────────────────────────────────────────────────────────── */
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: .9rem;
      margin-bottom: 1rem;
    }
    th {
      background: var(--navy);
      color: var(--white);
      padding: .45rem .6rem;
      text-align: left;
      font-weight: 600;
      font-size: .8rem;
      text-transform: uppercase;
      letter-spacing: .03em;
    }
    td {
      padding: .4rem .6rem;
      border-bottom: 1px solid var(--gray-200);
    }
    tr:nth-child(even) td { background: var(--gray-50); }
    tr.highlight td { background: #fefcbf; font-weight: 600; }

    /* ── Score badges ──────────────────────────────────────────────────── */
    .score { display: inline-block; padding: 2px 8px; border-radius: 4px; font-weight: 600; font-size: .85rem; }
    .score-green  { background: var(--green-bg); color: var(--green); }
    .score-yellow { background: var(--yellow-bg); color: var(--yellow); }
    .score-red    { background: var(--red-bg); color: var(--red); }

    /* ── Severity badges ──────────────────────────────────────────────── */
    .badge { display: inline-block; padding: 2px 10px; border-radius: 12px; font-size: .75rem; font-weight: 600; text-transform: uppercase; letter-spacing: .04em; }
    .badge-critical { background: var(--red); color: var(--white); }
    .badge-warning  { background: var(--gold); color: var(--navy-dark); }
    .badge-info     { background: var(--gray-200); color: var(--gray-700); }

    /* ── Trend arrows ─────────────────────────────────────────────────── */
    .trend-rising    { color: var(--green); }
    .trend-stable    { color: var(--gray-500); }
    .trend-declining { color: var(--red); }
    .trend-new       { color: var(--navy-light); }

    /* ── Charts ────────────────────────────────────────────────────────── */
    .chart-container { text-align: center; margin: 1rem 0; }
    .chart-container img { max-width: 100%; height: auto; }

    /* ── Alert cards ───────────────────────────────────────────────────── */
    .alert-card {
      border-radius: 6px;
      padding: .8rem 1rem;
      margin-bottom: .6rem;
      border-left: 4px solid;
    }
    .alert-critical { border-color: var(--red); background: var(--red-bg); }
    .alert-warning  { border-color: var(--gold); background: var(--yellow-bg); }
    .alert-info     { border-color: var(--gray-300); background: var(--gray-50); }

    /* ── Recommendation cards ─────────────────────────────────────────── */
    .rec-card { border-radius: 6px; padding: .8rem 1rem; margin-bottom: .6rem; border-left: 4px solid; }
    .rec-urgent    { border-color: var(--red); background: var(--red-bg); }
    .rec-important { border-color: var(--gold); background: var(--yellow-bg); }
    .rec-consider  { border-color: var(--navy-light); background: var(--gray-50); }
    .rec-card ul   { margin: .3rem 0 .3rem 1.2rem; font-size: .9rem; }
    .rec-card li   { margin-bottom: .2rem; }

    /* ── Progress bar ─────────────────────────────────────────────────── */
    .progress-bar { background: var(--gray-200); border-radius: 4px; height: 10px; overflow: hidden; }
    .progress-fill { height: 100%; border-radius: 4px; }

    /* ── Header / Footer (printed) ────────────────────────────────────── */
    .report-header {
      background: var(--navy);
      color: var(--white);
      padding: .4rem 1rem;
      font-size: .7rem;
      display: flex;
      justify-content: space-between;
      margin-bottom: 1rem;
    }
    .report-footer {
      border-top: 1px solid var(--gray-200);
      padding-top: .3rem;
      font-size: .7rem;
      color: var(--gray-500);
      display: flex;
      justify-content: space-between;
      margin-top: 1.5rem;
    }

    /* ── Competitor profile screenshots ────────────────────────────────── */
    .ad-thumbnail { width: 120px; height: 90px; object-fit: cover; border-radius: 4px; border: 1px solid var(--gray-200); }
    .ad-grid { display: flex; gap: .5rem; flex-wrap: wrap; margin: .5rem 0; }
  </style>
</head>
<body>
  {{{body}}}
</body>
</html>
