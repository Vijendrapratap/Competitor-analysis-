# =============================================================================
# Competitor Intelligence System — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env to git.
# =============================================================================

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Full connection string (preferred)
DATABASE_URL=postgresql://competitor_user:your-secure-password@localhost:5432/competitor_intel

# Individual fields (used as fallback when DATABASE_URL is absent)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=competitor_intel
DB_USER=competitor_user
DB_PASSWORD=your-secure-password
DB_SSL=false
# Maximum pool connections (default: 10)
DB_POOL_MAX=10

# ── Resend (Email) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Competitor Intel <intel@yourdomain.com>
# Comma-separated list of report recipient addresses
EMAIL_RECIPIENTS=analyst@yourdomain.com,manager@yourdomain.com
# Test email address for the test-email command
EMAIL_TEST_RECIPIENT=developer@yourdomain.com

# ── Apify (primary scraping backend) ──────────────────────────────────────────
# API token from https://console.apify.com/account/integrations
APIFY_API_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Maximum items per Apify actor run (default: 50)
APIFY_MAX_ITEMS_PER_RUN=50
# Actor execution timeout in seconds (default: 280)
APIFY_TIMEOUT_SECONDS=280
# Memory allocation per actor run in MB (default: 512)
APIFY_MEMORY_MB=512

# ── Playwright / Scraping (legacy — only used for Facebook Page metrics) ──────
# Path to system Chromium; leave blank to let Playwright download its own
CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium-browser
# Directory where Playwright stores browser binaries
PLAYWRIGHT_BROWSERS_PATH=/home/competitor/.cache/ms-playwright
# Viewport dimensions used for scraping sessions
SCRAPER_VIEWPORT_WIDTH=1440
SCRAPER_VIEWPORT_HEIGHT=900
# Maximum milliseconds to wait for a page to load
SCRAPER_TIMEOUT_MS=30000
# Milliseconds to wait between requests to avoid rate-limiting
SCRAPER_REQUEST_DELAY_MS=2000
# Maximum retry attempts on transient errors
SCRAPER_MAX_RETRIES=3
# Run browser in headless mode (true/false)
SCRAPER_HEADLESS=true

# ── Puppeteer / PDF generation ────────────────────────────────────────────────
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
# Paper format for generated PDFs
PDF_FORMAT=A4
# Directory where generated PDF reports are saved
PDF_OUTPUT_DIR=/home/competitor/competitor-intel-system/data/exports

# ── Screenshots ───────────────────────────────────────────────────────────────
SCREENSHOTS_DIR=/home/competitor/competitor-intel-system/data/screenshots

# ── Reports & Templates ───────────────────────────────────────────────────────
TEMPLATES_DIR=/home/competitor/competitor-intel-system/src/templates
REPORTS_DIR=/home/competitor/competitor-intel-system/data/exports

# ── Scheduling ───────────────────────────────────────────────────────────────
# The scheduler runs daily at 23:00 UTC (= 06:00 Bangkok time).
# Health check endpoint port (default: 3000)
HEALTH_PORT=3000

# ── Facebook / Meta Ads Library ───────────────────────────────────────────────
# Country code filter for the Meta Ads Library
META_ADS_COUNTRY=TH
# Maximum ads to scrape per competitor per run
META_ADS_MAX_PER_COMPETITOR=50

# ── OpenRouter (LLM Intelligence Layer) ─────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Primary model for deep strategy analysis
OPENROUTER_PRIMARY_MODEL=anthropic/claude-sonnet-4-5
# Fallback model if primary is unavailable
OPENROUTER_FALLBACK_MODEL=google/gemini-2.0-flash-001
# Maximum tokens per analysis request (default: 2000)
OPENROUTER_MAX_TOKENS=2000
# Maximum retry attempts on API errors (default: 2)
OPENROUTER_MAX_RETRIES=2
# Site URL and app title (required by OpenRouter headers)
OPENROUTER_SITE_URL=https://pratap.ai
OPENROUTER_APP_TITLE=Hua Hin Competitor Intelligence

# ── LLM Cache ─────────────────────────────────────────────────────────────────
# TTL for cached LLM responses in hours (default: 24)
LLM_CACHE_TTL_HOURS=24

# ── Google Trends ─────────────────────────────────────────────────────────────
# Two-letter country code for Google Trends
GOOGLE_TRENDS_GEO=TH
# How many days of historical data to fetch (default: 90)
GOOGLE_TRENDS_TIMEFRAME_DAYS=90
# Milliseconds to wait between API requests (default: 2000)
GOOGLE_TRENDS_REQUEST_DELAY_MS=2000
# Maximum retry attempts on transient errors
GOOGLE_TRENDS_MAX_RETRIES=3
# Optional: override default keywords (comma-separated)
# GOOGLE_TRENDS_KEYWORDS=hua hin hotel,hua hin resort,hua hin pool villa

# ── Analysis Thresholds ───────────────────────────────────────────────────────
# Health-score weight: paid vs organic (must sum to 100)
HEALTH_SCORE_PAID_WEIGHT=50
HEALTH_SCORE_ORGANIC_WEIGHT=50
# Threat-level boundaries (0–100)
THREAT_HIGH_THRESHOLD=75
THREAT_MEDIUM_THRESHOLD=40
